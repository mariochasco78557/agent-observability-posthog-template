# Copy to .env and load it yourself (the library does not read .env files):
#   set -a; . ./.env; set +a
# or, under systemd: EnvironmentFile=-%h/.config/<your-job>/posthog.env

# Project API key: PostHog > Project settings > Project API key (starts with phc_). Keep it out of git.
POSTHOG_API_KEY=
# US Cloud: https://us.i.posthog.com   EU Cloud: https://eu.i.posthog.com
POSTHOG_HOST=https://eu.i.posthog.com

# Absolute path to Claude Code if it is not on PATH (systemd units have a minimal PATH)
# CLAUDE_BIN=/home/you/.local/bin/claude

# Kill switch: 1 disables telemetry even when a key is present
# AGENT_OBS_DISABLED=1
